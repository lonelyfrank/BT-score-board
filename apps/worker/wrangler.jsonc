{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bt-darts",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The PWA built with `pnpm --filter @bt/web build:cloud`; unknown paths get index.html.
  "assets": {
    "directory": "../web/dist-cloud",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "GameRoom" }],
  },
  // SQLite-backed Durable Objects are available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Daily backup at 05:00 UTC; it only runs when an R2 bucket is bound as BACKUPS:
  // "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "bt-darts-backups" }],
  "triggers": { "crons": ["0 5 * * *"] },
  "observability": { "enabled": true },
}
