{
  "name": "bt-darts-scoreboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server/main.ts",
    "build": "tsc -p tsconfig.build.json && npm run build --prefix apps/web && npm run build:shared --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "start": "node dist/apps/api/src/server/main.js",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix apps/web && npm run typecheck --prefix apps/worker",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "check": "npm run typecheck && vitest run && npm run build",
    "check:release": "npm run format:check && npm run check && npm run smoke && npm run test:e2e",
    "test:e2e": "npm run test:e2e --prefix apps/web",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:backup": "tsx packages/database/src/backup.ts",
    "seed": "tsx scripts/seed.ts",
    "openapi": "tsx scripts/openapi.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "tsc -p tsconfig.build.json && node dist/scripts/smoke.js",
    "dev:web:shared": "npm run dev:shared --prefix apps/web",
    "dev:cloud": "npm run build:cloud --prefix apps/web && npm run dev --prefix apps/worker",
    "dev:online": "npm run dev:cloud --prefix apps/web",
    "deploy:cloud": "npm run build:cloud --prefix apps/web && npm run deploy --prefix apps/worker"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
